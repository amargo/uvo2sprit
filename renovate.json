{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "group:monorepos",
    "group:recommended",
    ":pinDigestsDisabled",
    "workarounds:all",
    "abandonments:recommended"
  ],
  "timezone": "Europe/Budapest",
  "schedule": [
    "after 1am and before 5am on friday"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "dockerfile",
    "pip_requirements",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard",
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "🐋 Docker minor updates",
      "automerge": true,
      "pinDigests": false
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "🚢 Docker major updates",
      "pinDigests": false
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "groupName": "🐍 Python minor updates"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "🐍 Python major updates",
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "groupName": "⚡ GitHub Actions updates"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "groupName": "🔖 Patch updates"
    },
    {
      "description": "dateutil ritkán ad ki, ne legyen túl szigorú a küszöb",
      "matchPackageNames": [
        "python-dateutil"
      ],
      "abandonmentThreshold": "4 years"
    },
    {
      "description": "coloredlogs: ideiglenesen elfogadjuk",
      "matchPackageNames": [
        "coloredlogs"
      ],
      "abandonmentThreshold": "10 years"
    },
    {
      "description": "Hyundai/Kia API is frissülhet, de mostantól heti egy futás elég",
      "matchPackageNames": [
        "hyundai_kia_connect_api"
      ]
    }
  ]
}
