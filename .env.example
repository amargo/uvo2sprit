# UVO/Bluelink API credentials
UVO_USERNAME=your_kia_username
UVO_PASSWORD=your_kia_password
UVO_VEHICLE_UUID=your_vehicle_uuid
UVO_PIN=1234
UVO_KIA_LANGUAGE=hu       # default hu

# SpritMonitor API credentials
SPRITMONITOR_BEARER_TOKEN=your_bearer_token
SPRITMONITOR_APP_TOKEN=190e3b1080a39777f369a4e9875df3d7 # https://community.home-assistant.io/t/rest-sensor-for-spritmonitor-de-vehicle-fuel-and-cost-tracker/766137/5
SPRITMONITOR_VEHICLE_ID=your_vehicle_id
SPRITMONITOR_TANK_ID=1
ELECTRICITY_PRICE=41  # Price per kWh (optional)
CURRENCY_ID=11  # HUF
COUNTRY=HU  # Country code
STATION_NAME=home  # Charging station name

# Upload behaviour (all optional)
SM_QUANTITY_MODE=gross        # gross (incl. regeneration) | net
SM_FUELSORT_ID=19             # 19 = Elektrizitaet, 24 = Oekostrom
SM_FORCE_FULL_PERCENT=true    # always send 100% SoC, see README
SM_SEND_LIVE_CHARGE_INFO=false # attach the car's CURRENT charge type to historical days
SM_MAX_DAYS_PER_RUN=10        # cap the backfill to protect the 200 req/day UVO limit
BATTERY_TOTAL_KWH=70          # usable + unusable kWh + charger losses (e-Niro MY20)
DATA_TIMEZONE=Europe/Budapest # day boundaries are evaluated in this timezone
LOG_LEVEL=INFO                # DEBUG for the raw API responses
